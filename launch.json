
{
  "version": "0.2.0",
  "configurations": [
    
    {
      "type": "editor-browser",
      "request": "launch",
      "name": "Launch Integrated Browser against localhost",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Express Server",
      "program": "${workspaceFolder}/app.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
